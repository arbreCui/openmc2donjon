{
  "acceptance": {
    "fail_on_violation": true,
    "max_flux_ratio_residual": 1e-12,
    "max_sph_rel_change": 1e-12,
    "min_completed_iterations": 2,
    "require_converged": true,
    "require_final_solve": true,
    "sph_maximum_ceiling": 1.0,
    "sph_minimum_floor": 0.5
  },
  "clip_max": 2.0,
  "clip_min": 0.5,
  "convergence": {
    "fail_on_nonconvergence": true,
    "flux_ratio_tolerance": 1e-12,
    "min_iterations": 2,
    "sph_change_tolerance": 1e-12
  },
  "damping": 0.5,
  "final_solve": true,
  "format": "macrolib",
  "input_h5": "inputs/mgxs_library.h5",
  "iterations": 2,
  "map_h5": "inputs/flux_map.h5",
  "output_dir": "sph_loop",
  "postprocess": {
    "command": [
      "python3",
      "fake_low_order_solver.py",
      "apply",
      "--input",
      "{workflow_ascii}",
      "--output",
      "{output}",
      "--sph",
      "{sph_sidecar}",
      "--iteration",
      "{iteration1}"
    ],
    "output": "corrected.macrolib.txt"
  },
  "reference_flux": "inputs/reference_flux.h5::openmc_volume_flux",
  "schema": "openmc2donjon.sph-loop-config.v1",
  "solver": {
    "command": [
      "python3",
      "fake_low_order_solver.py",
      "solve",
      "--macrolib",
      "{ascii_input}",
      "--result",
      "{result}",
      "--iteration",
      "{iteration}"
    ],
    "result": "low_order_flux.result"
  },
  "source_label": "SPH loop minicase low-order flux",
  "sph_applied": false,
  "sph_kind": "sph-loop-minicase",
  "sph_real": false
}
