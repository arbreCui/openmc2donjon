* Full-core assembly-wise OpenMC minicase low-order DONJON solve.
* case_id: {case_id}
* iteration: {iteration}
*
* The 3x3 CAR2D mesh mirrors the OpenMC assembly-domain ordering:
*   1 2 3
*   4 5 6
*   7 8 9
MODULE GEO: TRIVAT: TRIVAA: FLUD: GREP: UTL: END: ABORT: ;
LINKED_LIST MACRO GEOM TRACK SYS FLUX ;
REAL keff ;
SEQ_ASCII MACRO_ASC :: FILE '{macrolib}' ;

MACRO := MACRO_ASC ;
GEOM := GEO: :: CAR2D 3 3
  EDIT 0
  X- REFL X+ REFL
  Y- REFL Y+ REFL
  MIX
  1 2 3
  4 5 6
  7 8 9
  MESHX
  0.00000000 3.00000000 6.00000000 9.00000000
  MESHY
  0.00000000 3.00000000 6.00000000 9.00000000
;

TRACK := TRIVAT: GEOM ::
  TITLE 'OpenMC2DONJON full-core assembly-wise minicase solve {iteration}'
  EDIT 1 MAXR 64
  DUAL 1 1 ;
SYS := TRIVAA: MACRO TRACK :: EDIT 0 ;
FLUX := FLUD: SYS TRACK :: EDIT 1 ADI 4 ACCE 5 3 EXTE 700 1.E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE ' 1 >>keff<< ;
ECHO 'OPENMC2DONJON FULL CORE MINICASE REAL DONJON ITER {iteration} K-EFFECTIVE' keff ;
UTL: FLUX :: IMPR STATE-VECTOR * DUMP ;
END: ;
