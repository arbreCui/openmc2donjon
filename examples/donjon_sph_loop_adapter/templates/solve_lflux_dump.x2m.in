* Minimal runnable DONJON low-order solve deck for run-sph-loop.
* case_id: {case_id}
* iteration: {iteration}
*
* The default geometry is a tiny 1x2 Cartesian smoke model with two mixtures.
* For production, keep the SEQ_ASCII input and final UTL dump line, then replace
* the GEOM/TRACK/SYS/FLUX body with the DONJON model for your case.
MODULE GEO: TRIVAT: TRIVAA: FLUD: GREP: UTL: END: ABORT: ;
LINKED_LIST MACRO GEOM TRACK SYS FLUX ;
REAL keff ;
SEQ_ASCII MACRO_ASC :: FILE '{macrolib}' ;

MACRO := MACRO_ASC ;
GEOM := GEO: :: CAR2D 2 1
  EDIT 0
  X- REFL X+ VOID
  Y- REFL Y+ VOID
  MIX
  1 2
  MESHX
  0.00000000 10.00000000 20.00000000
  MESHY
  0.00000000 10.00000000
;

TRACK := TRIVAT: GEOM ::
  TITLE 'openmc2donjon adapter 1x2 solve' EDIT 1 MAXR 32
  DUAL 1 1 ;
SYS := TRIVAA: MACRO TRACK :: EDIT 0 ;
FLUX := FLUD: SYS TRACK :: EDIT 1 ADI 4 ACCE 5 3 EXTE 200 1.E-6 ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE ' 1 >>keff<< ;
ECHO 'OPENMC2DONJON DONJON SPH LOOP ADAPTER K-EFFECTIVE' keff ;
UTL: FLUX :: IMPR STATE-VECTOR * DUMP ;
END: ;
