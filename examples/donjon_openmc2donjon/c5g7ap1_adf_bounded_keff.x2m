*  C5G7 OpenMC -> DONJON assembly-wise k-eff input.
*  Each assembly-sized node consumes one homogenized OpenMC MGXS mixture.
*  Mesh: 3 x 3, pitch=21.42000000 cm.
*  TRIVAT: DUAL 1 1.
*  SPN: off.
*----
MODULE GEO: NCR: TRIVAT: TRIVAA: FLUD: END: ABORT: ;
LINKED_LIST CPO MACRO GEOM TRACK SYS FLUX ;
REAL keff ;
SEQ_ASCII CPO_ASC :: FILE '/Users/wen/dragon-5.1/Donjon/data/openmc2donjon/c5g7ap1_adf_bounded.mco' ;

CPO := CPO_ASC ;
MACRO := NCR: CPO :: EDIT 1 MACRO NMIX 9
  COMPO CPO CPO
  MIX 1 USE ENDMIX (* ASM_Y01_X01 *)
  MIX 2 USE ENDMIX (* ASM_Y01_X02 *)
  MIX 3 USE ENDMIX (* ASM_Y01_X03 *)
  MIX 4 USE ENDMIX (* ASM_Y02_X01 *)
  MIX 5 USE ENDMIX (* ASM_Y02_X02 *)
  MIX 6 USE ENDMIX (* ASM_Y02_X03 *)
  MIX 7 USE ENDMIX (* ASM_Y03_X01 *)
  MIX 8 USE ENDMIX (* ASM_Y03_X02 *)
  MIX 9 USE ENDMIX (* ASM_Y03_X03 *)
;

GEOM := GEO: :: CAR2D 3 3
  EDIT 0
  X- REFL X+ VOID
  Y- REFL Y+ VOID
  MIX
  1 2 3
  4 5 6
  7 8 9
  MESHX
  0.00000000 21.42000000 42.84000000 64.26000000
  MESHY
  0.00000000 21.42000000 42.84000000 64.26000000
;

TRACK := TRIVAT: GEOM ::
  TITLE 'C5G7 OpenMC converter assembly-wise smoke' EDIT 1 MAXR 109
  DUAL 1 1 ;
SYS := TRIVAA: MACRO TRACK :: EDIT 0 ;
FLUX := FLUD: SYS TRACK :: EDIT 1 ADI 4 ACCE 5 3 EXTE 700 1.E-6 ;
END: ;
