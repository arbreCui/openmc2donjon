*----
*  C5G7 production ADF effect check with the nodal solver.
*  Same OpenMC production ADF macrolib, same NSST tracking:
*    FLUX_ADF  = NSSF with discontinuity factors active.
*    FLUX_NODF = NSSF with discontinuity factors forced to unity.
*----
MODULE GEO: NCR: NSST: NSSF: GREP: END: ABORT: ;
LINKED_LIST CPO MACRO GEOM TRACK FLUX_ADF FLUX_NODF ;
REAL keff_adf keff_nodf ;
SEQ_ASCII CPO_ASC :: FILE '/Users/wen/dragon-5.1/Donjon/data/openmc2donjon/c5g7pa.mco' ;

CPO := CPO_ASC ;
MACRO := NCR: CPO :: EDIT 1 MACRO NMIX 9
  COMPO CPO CPO
  MIX 1 USE ENDMIX (* ASM_Y01_X01 *)
  MIX 2 USE ENDMIX (* ASM_Y01_X02 *)
  MIX 3 USE ENDMIX (* ASM_Y01_X03 *)
  MIX 4 USE ENDMIX (* ASM_Y02_X01 *)
  MIX 5 USE ENDMIX (* ASM_Y02_X02 *)
  MIX 6 USE ENDMIX (* ASM_Y02_X03 *)
  MIX 7 USE ENDMIX (* ASM_Y03_X01 *)
  MIX 8 USE ENDMIX (* ASM_Y03_X02 *)
  MIX 9 USE ENDMIX (* ASM_Y03_X03 *)
;

GEOM := GEO: :: CAR2D 3 3
  EDIT 0
  X- REFL X+ VOID
  Y- REFL Y+ VOID
  MIX
  1 2 3
  4 5 6
  7 8 9
  MESHX
  0.00000000 21.42000000 42.84000000 64.26000000
  MESHY
  0.00000000 21.42000000 42.84000000 64.26000000
;

TRACK := NSST: GEOM ::
  TITLE 'C5G7 OpenMC production ADF nodal effect'
  EDIT 2 MAXR 109 ANM ;

FLUX_ADF := NSSF: TRACK MACRO :: EDIT 1 NUPD 100 1.E-6 EXTE 700 1.E-6 ;
GREP: FLUX_ADF :: GETVAL 'K-EFFECTIVE ' 1 >>keff_adf<< ;

FLUX_NODF := NSSF: TRACK MACRO :: EDIT 1 NODF NUPD 100 1.E-6 EXTE 700 1.E-6 ;
GREP: FLUX_NODF :: GETVAL 'K-EFFECTIVE ' 1 >>keff_nodf<< ;

ECHO 'OPENMC2DONJON C5G7 PRODUCTION ADF NSSF K-EFFECTIVE' keff_adf ;
ECHO 'OPENMC2DONJON C5G7 PRODUCTION NODF NSSF K-EFFECTIVE' keff_nodf ;
END: ;
